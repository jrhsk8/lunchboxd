# Cloudflare Pages serves this verbatim. Defence in depth rather than a live
# hole: React escapes everything, there is no dangerouslySetInnerHTML anywhere,
# and the one user-controlled rendering path (ReviewText) builds React nodes
# rather than markup.
#
# connect-src has to cover both the REST calls and the realtime websocket —
# `useBoard` subscribes to postgres_changes, and a CSP that blocks wss: breaks
# the live feed silently, with the poll gone there is nothing to fall back to.
#
# The font is self-hosted (see index.html), so font-src is 'self' alone and no
# Google origin appears anywhere in this policy. Keep it that way.
#
# style-src needs 'unsafe-inline': Tailwind ships a stylesheet, but the app also
# sets inline `style` for the star fill width and the tag font sizes.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://kxbteesmfozqzoxzktzv.supabase.co wss://kxbteesmfozqzoxzktzv.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Fingerprinted by Vite, so they can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted, but they change roughly never.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
